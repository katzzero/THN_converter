  "technical_specs": {
    "ffmpeg_command": "ffmpeg -i <filepath> 2>&1",
    "parsing_method": "Regex-based string parsing from stderr output",
    "metadata_location": "stderr, not stdout",
    "execution_mode": "async/await with Process",
    "stream_types": {
      "video": "Contains 'Video:' in stream line",
      "audio": "Contains 'Audio:' in stream line",
      "subtitle": "Contains 'Subtitle:' in stream line",
      "data": "Contains 'Data:' in stream line"
    },
    "hdr_detection": {
      "method": "Cascade checking - use first match",
      "priority": [
        "smpte2084 (HDR10)",
        "hlg (Hybrid Log-Gamma)",
        "smpte431 (DCI-P3 47mm)",
        "smpte432 (DCI-P3)"
      ]
    },
    "color_space_parsing": {
      "pattern": "Format: (tv|pc), (colorspace)/...",
      "examples": {
        "sdr": "yuv420p(tv, bt709/bt709/bt709, progressive) -> SDR, bt709",
        "hdr": "yuv420p10le(tv, bt2020nc/unknown/unknown, progressive) -> HDR, bt2020",
        "dcip3": "yuv420p(unknown, smpte432/unknown/smpte2084) -> HDR, smpte432"
      }
    }
  },
  
