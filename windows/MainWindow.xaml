<Window x:Class="THN_Converter_Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:THN_Converter_Win.ViewModels"
        xmlns:conv="clr-namespace:THN_Converter_Win.Converters"
        Title="THN Converter" Height="750" Width="850"
        MinWidth="700" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <Style x:Key="SettingRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="Label">
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MonospaceText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <!-- ════════════ TAB 1: Principal ════════════ -->
        <TabItem Header="🎬 Principal">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drop Zone -->
                <Border Grid.Row="0" BorderThickness="2"
                        CornerRadius="8" Height="180" Margin="0,0,0,15"
                        Background="{StaticResource SurfaceBrush}"
                        MouseDown="DropZone_MouseDown"
                        Cursor="Hand">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource AccentBlue}" Opacity="0.4"/>
                    </Border.BorderBrush>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding DroppedFileName}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding DroppedFilePath, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Output Selection -->
                <Border Grid.Row="1" BorderThickness="1"
                        CornerRadius="6" Padding="15" Margin="0,0,0,15"
                        Background="{StaticResource SurfaceBrush}"
                        MouseDown="OutputZone_MouseDown"
                        Cursor="Hand">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{StaticResource BorderColor}"/>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="💾 Destino da Conversão" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="{Binding OutputFileName}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding OutputFilePath, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="Clique para escolher destino" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding OutputFilePath, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📁 Selecionar Destino"
                                Command="{Binding SelectOutputCommand}"
                                Height="40" Padding="15,0"
                                IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Progress -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <ProgressBar Value="{Binding ConversionProgress}" Maximum="1.0" Height="20"/>
                    <TextBlock Text="{Binding ProgressPercent}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Convert / Cancel Buttons -->
                <Grid Grid.Row="3">
                    <Button Content="▶ Converter" Command="{Binding ConvertCommand}"
                            Height="50" FontSize="18" FontWeight="Bold"
                            Visibility="{Binding IsConverting, Converter={StaticResource InverseBoolToVis}}"
                            IsEnabled="{Binding DroppedFilePath, Converter={StaticResource NullToBool}}"/>
                    <Button Content="⏹ Cancelar" Command="{Binding CancelCommand}"
                            Height="50" FontSize="18" FontWeight="Bold"
                            Background="{StaticResource ErrorBrush}"
                            Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ════════════ TAB 2: Opções ════════════ -->
        <TabItem Header="⚙️ Opções">
            <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Video Settings -->
                    <GroupBox Header="🎬 Vídeo" Margin="0,0,0,15" Padding="15">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}">
                                <Label Content="Codec:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedVideoCodec}" Width="220">
                                    <ComboBoxItem Content="H.264"/>
                                    <ComboBoxItem Content="H.265/HEVC"/>
                                    <ComboBoxItem Content="ProRes"/>
                                    <ComboBoxItem Content="DNxHD"/>
                                    <ComboBoxItem Content="VP9"/>
                                    <ComboBoxItem Content="MPEG-4"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}">
                                <Label Content="Qualidade (CRF):" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedQuality}" Width="220">
                                    <ComboBoxItem Content="0 (Máxima)"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="23 (Padrão)"/>
                                    <ComboBoxItem Content="28"/>
                                    <ComboBoxItem Content="35"/>
                                    <ComboBoxItem Content="50 (Mínima)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}">
                                <Label Content="Resolução:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedResolution}" Width="220">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="3840x2160 (4K)"/>
                                    <ComboBoxItem Content="1920x1080 (Full HD)"/>
                                    <ComboBoxItem Content="1280x720 (HD)"/>
                                    <ComboBoxItem Content="854x480 (SD)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}">
                                <Label Content="Framerate:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedFramerate}" Width="220">
                                    <ComboBoxItem Content="Original"/>
                                    <ComboBoxItem Content="60"/>
                                    <ComboBoxItem Content="59.94"/>
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="29.97"/>
                                    <ComboBoxItem Content="24"/>
                                    <ComboBoxItem Content="23.976"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Audio Settings -->
                    <GroupBox Header="🔊 Áudio" Margin="0,0,0,15" Padding="15">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}">
                                <Label Content="Codec:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedAudioCodec}" Width="250">
                                    <ComboBoxItem Content="copy (não converter)"/>
                                    <ComboBoxItem Content="AAC"/>
                                    <ComboBoxItem Content="MP3"/>
                                    <ComboBoxItem Content="Opus"/>
                                    <ComboBoxItem Content="Vorbis"/>
                                    <ComboBoxItem Content="FLAC"/>
                                    <ComboBoxItem Content="PCM"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}"
                                        Visibility="{Binding ShowAudioSettings, Converter={StaticResource BoolToVis}}">
                                <Label Content="Bitrate:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedAudioBitrate}" Width="220">
                                    <ComboBoxItem Content="320k"/>
                                    <ComboBoxItem Content="256k"/>
                                    <ComboBoxItem Content="192k"/>
                                    <ComboBoxItem Content="128k"/>
                                    <ComboBoxItem Content="96k"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SettingRow}"
                                        Visibility="{Binding ShowAudioSettings, Converter={StaticResource BoolToVis}}">
                                <Label Content="Sample Rate:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding SelectedAudioSampleRate}" Width="220">
                                    <ComboBoxItem Content="48000"/>
                                    <ComboBoxItem Content="44100"/>
                                    <ComboBoxItem Content="96000"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Timecode Overlay -->
                    <GroupBox Header="⏱️ Timecode Overlay" Padding="15">
                        <StackPanel>
                            <CheckBox Content="Mostrar Timecode" IsChecked="{Binding ShowTimecode}" Margin="0,0,0,10"/>
                            <StackPanel Style="{StaticResource SettingRow}"
                                        Visibility="{Binding ShowTimecode, Converter={StaticResource BoolToVis}}">
                                <Label Content="Posição:" Style="{StaticResource SettingLabel}"/>
                                <ComboBox SelectedValue="{Binding TimecodePosition}" Width="220">
                                    <ComboBoxItem Content="top-left"/>
                                    <ComboBoxItem Content="top-center"/>
                                    <ComboBoxItem Content="top-right"/>
                                    <ComboBoxItem Content="bottom-left"/>
                                    <ComboBoxItem Content="bottom-center"/>
                                    <ComboBoxItem Content="bottom-right"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ════════════ TAB 3: Log ════════════ -->
        <TabItem Header="📋 Log">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 Log de Conversão" FontSize="14"
                           FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" Text="{Binding LogOutput, Mode=OneWay}"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </TabItem>

        <!-- ════════════ TAB 4: Info ════════════ -->
        <TabItem Header="ℹ️ Info">
            <Grid Margin="20">
                <!-- Loading State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsFetchingMetadata, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Extraindo metadados..." FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aguarde enquanto analisamos o arquivo" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <ProgressBar IsIndeterminate="True" Width="300" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasMetadata, Converter={StaticResource InverseBoolToVis}}"
                            IsEnabled="False">
                    <TextBlock Text="Nenhum arquivo selecionado" FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Arraste ou selecione um arquivo para ver os detalhes técnicos"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Metadata Content -->
                <ScrollViewer Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <GroupBox Header="FILE" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding FileMetadata.Filename, StringFormat='Nome: {0}'}"/>
                                <TextBlock Text="{Binding FileMetadata.Container, StringFormat='Container: {0}'}"/>
                                <TextBlock Text="{Binding FileMetadata.Duration, StringFormat='Duração: {0}'}"/>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="Selecione um arquivo para ver metadados completos."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
